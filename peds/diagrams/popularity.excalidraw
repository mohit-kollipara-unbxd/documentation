      "frameId": null,
      "roundness": null,
      "seed": 1123,
      "version": 1,
      "versionNonce": 1124,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Dual mode at runtime:\nIndexed v2: Solr has unx_popularity_* \u2192 exists() boosts\nRedis-backed: PopularityNode + product_scores path\n\nPOP_REDIS_DB default 1 (same host as UB, diff DB)",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Dual mode at runtime:\nIndexed v2: Solr has unx_popularity_* \u2192 exists() boosts\nRedis-backed: PopularityNode + product_scores path\n\nPOP_REDIS_DB default 1 (same host as UB, diff DB)",
      "lineHeight": 1.25
    },
