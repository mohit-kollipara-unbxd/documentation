    {
      "id": "Uj3EKh0ter7z",
      "type": "text",
      "x": 60,
      "y": 1220,
      "width": 720,
      "height": 117,
      "angle": 0,
      "strokeColor": "#000000",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1121,
      "version": 1,
      "versionNonce": 1122,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Enablement (two gates):\n\u2022 mimir.popularity.enable=true\n\u2022 mimir.defaultPopularity.enable=true (often off by default)\n\u2022 enablePopularity, enableTrendingProducts\n\u2022 popularity.version v1|v2, popularity.expId\n\u2022 popularity.segments.* for header/param segments\n\u2022 mimir.popularity.buckets \u2192 Redis key suffixes",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Enablement (two gates):\n\u2022 mimir.popularity.enable=true\n\u2022 mimir.defaultPopularity.enable=true (often off by default)\n\u2022 enablePopularity, enableTrendingProducts\n\u2022 popularity.version v1|v2, popularity.expId\n\u2022 popularity.segments.* for header/param segments\n\u2022 mimir.popularity.buckets \u2192 Redis key suffixes",
      "lineHeight": 1.25
    },
    {
      "id": "gHJn4IIrVaPD",
      "type": "text",
      "x": 820,
      "y": 1220,
      "width": 660,
      "height": 85,
      "angle": 0,
      "strokeColor": "#000000",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "roughness": 0,
      "opacity": 100,
