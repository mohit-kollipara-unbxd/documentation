      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "product_score logic:\n\u2022 Events CLICK/CART/ORDER weighted\n\u2022 Time decay over clickstream_duration_in_days\n\u2022 Optional feed blend (clickstream_feed_weight)\n\u2022 group_by_store \u2192 per-store maps\n\u2022 Normalize min-max; max_products default 5000\n\u2022 No clickstream \u2192 sys.exit(-1)",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "DZUsoweGqzKm",
      "originalText": "product_score logic:\n\u2022 Events CLICK/CART/ORDER weighted\n\u2022 Time decay over clickstream_duration_in_days\n\u2022 Optional feed blend (clickstream_feed_weight)\n\u2022 group_by_store \u2192 per-store maps\n\u2022 Normalize min-max; max_products default 5000\n\u2022 No clickstream \u2192 sys.exit(-1)",
      "lineHeight": 1.25
    },
