      "versionNonce": 1126,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Important: Mimir does NOT call Aragorn directly.\nBoth Mode A and Mode B always go: Mimir \u2192 Reranker \u2192 (Aragorn | ISVC).",
