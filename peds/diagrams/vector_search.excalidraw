      "version": 1,
      "versionNonce": 1080,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Gates & params:\n\u2022 reranker.recommend=true\n\u2022 reranker.recommend.platform=semantic_search\n\u2022 reranker.recommend.patchProducts=true\n\u2022 reranker.recommend.patchProducts.count (default 10)\n\u2022 reranker.recommend.patchProducts.minTokenCount\n\u2022 SkipRecReranker helper (mimir/network/node/helper.go)",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Gates & params:\n\u2022 reranker.recommend=true\n\u2022 reranker.recommend.platform=semantic_search\n\u2022 reranker.recommend.patchProducts=true\n\u2022 reranker.recommend.patchProducts.count (default 10)\n\u2022 reranker.recommend.patchProducts.minTokenCount\n\u2022 SkipRecReranker helper (mimir/network/node/helper.go)",
      "lineHeight": 1.25
    },
