    {
      "id": "g9sDUNtEFYis",
      "type": "text",
      "x": 60,
      "y": 1550,
      "width": 720,
      "height": 101,
      "angle": 0,
      "strokeColor": "#000000",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1221,
      "version": 1,
      "versionNonce": 1222,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "\u2022 Hybrid never patches \u2192 patchProducts false / SkipRecReranker / minTokenCount\n\u2022 SS never fires \u2192 fallback.method missing ss / maxResultsForTrigger / minTokenCount\n\u2022 Empty semantic \u2192 thresholds, QS skip, short query\n\u2022 Deployment not found \u2192 check aragorn#recommend in Albus\n\u2022 ISVC errors \u2192 inference id, namespace, auth cookie, stale version\n\u2022 Wrong reranker binary \u2192 Envoy configmap goRoutesSemantic vs pyreranker",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "\u2022 Hybrid never patches \u2192 patchProducts false / SkipRecReranker / minTokenCount\n\u2022 SS never fires \u2192 fallback.method missing ss / maxResultsForTrigger / minTokenCount\n\u2022 Empty semantic \u2192 thresholds, QS skip, short query\n\u2022 Deployment not found \u2192 check aragorn#recommend in Albus\n\u2022 ISVC errors \u2192 inference id, namespace, auth cookie, stale version\n\u2022 Wrong reranker binary \u2192 Envoy configmap goRoutesSemantic vs pyreranker",
      "lineHeight": 1.25
    },
    {
      "id": "o6jS8SGIZNey",
      "type": "text",
      "x": 800,
      "y": 1550,
      "width": 680,
      "height": 117,
