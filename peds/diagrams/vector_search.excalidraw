      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Defaults cheat sheet:\nReranker fetch count = 100\nHybrid Solr patch = 10 products\nCerebro max_predictions = 100\nAragorn RRF default limit = 100\n\nHandlers: image_search, pdp force semantic off (enablement.md \u00a78)",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
