    {
      "id": "HUueBqTleyOK",
      "type": "text",
      "x": 60,
      "y": 700,
      "width": 720,
      "height": 85,
      "angle": 0,
      "strokeColor": "#000000",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1123,
      "version": 1,
      "versionNonce": 1124,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Optional SS behaviors:\n\u2022 fallback.ss.hybridSearch=true \u2192 re-query Solr with OR-boosted SS product IDs\n\u2022 fallback.ss.includeOriginalResults \u2192 merge keyword + vector ordering\n\u2022 fallback.ss.enableNetwork \u2014 wire fallback DAG leg\nDisable SS: remove ss from fallback.method OR fallback.ss.maxResultsForTrigger=0",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Optional SS behaviors:\n\u2022 fallback.ss.hybridSearch=true \u2192 re-query Solr with OR-boosted SS product IDs\n\u2022 fallback.ss.includeOriginalResults \u2192 merge keyword + vector ordering\n\u2022 fallback.ss.enableNetwork \u2014 wire fallback DAG leg\nDisable SS: remove ss from fallback.method OR fallback.ss.maxResultsForTrigger=0",
      "lineHeight": 1.25
    },
    {
      "id": "BxBp9L8HtYTd",
      "type": "text",
      "x": 820,
      "y": 700,
      "width": 660,
      "height": 36,
      "angle": 0,
      "strokeColor": "#000000",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
