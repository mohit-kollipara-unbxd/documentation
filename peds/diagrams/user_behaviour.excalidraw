      "roundness": null,
      "seed": 1105,
      "version": 1,
      "versionNonce": 1106,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Enablement (two-level gate):\n\u2022 mimir.ub.enable=true (schema default false)\n\u2022 user.behaviour=true\n\u2022 Disable: user.behaviour=false OR mimir.ub.enable=false\n\u2022 mimir.ub.multiplier, user.behaviour.expId\n\u2022 mimir.scores.multiplicative \u2192 merge mode with Popularity",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Enablement (two-level gate):\n\u2022 mimir.ub.enable=true (schema default false)\n\u2022 user.behaviour=true\n\u2022 Disable: user.behaviour=false OR mimir.ub.enable=false\n\u2022 mimir.ub.multiplier, user.behaviour.expId\n\u2022 mimir.scores.multiplicative \u2192 merge mode with Popularity",
      "lineHeight": 1.25
    },
    {
      "id": "aSMCL4MeOPYL",
      "type": "text",
      "x": 820,
      "y": 750,
      "width": 660,
      "height": 68,
      "angle": 0,
