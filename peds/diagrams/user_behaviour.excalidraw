      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Critical ops note:\nUB lookup key uses ANALYZED query string.\nIf Analysis normalizes differently than training tokenization,\nRedis miss \u2192 empty boost with no hard error.",
